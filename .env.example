# Neon pooled PostgreSQL URL. Server-only: never use NEXT_PUBLIC_ for this value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set a random secret (at least 32 bytes) for first administrator setup; remove after setup.
ADMIN_SETUP_TOKEN=
# Existing survey Blob store; keep while migrating survey data separately.
BLOB_READ_WRITE_TOKEN=

# Independent 32-byte encryption key (64 hex characters) for social credentials.
# Generate with openssl rand -hex 32; retain securely, never NEXT_PUBLIC_ or in Git.
SOCIAL_CREDENTIALS_KEY=
